# anitexas 环境变量模板
# 部署到：/opt/anitexas/shared/anitexas.env（systemd EnvironmentFile）
# 注意：EnvironmentFile 不做引号/变量展开，值写裸文本，一行一个 KEY=VALUE。

# ---- 服务基础 ----
# 运行环境：production / staging / dev
APP_ENV=production
# 监听地址与端口：nginx 反代到 127.0.0.1，不对外直接暴露
# 默认 8081：karuta 同机独占 8080，见 deploy/README.md「与 karuta 同机共存」一节
# 注意：这是**后端内网端口**；对外访问走 nginx 单 :80 的子路径 /anitexas/（nginx 由 portal 仓库统一维护），两者别混
BIND_ADDR=127.0.0.1
PORT=8081
# 日志级别：debug / info / warn / error
LOG_LEVEL=info
# 跨域来源（逗号分隔）：同源部署（nginx 同域反代）可留空
CORS_ALLOWED_ORIGINS=

# ---- 产物路径（产物统一落 data/ 约定，线上即 /data/anitexas，见 architecture.md §3）----
# 可写数据根（SQLite 与备份的父目录，systemd ReadWritePaths 与此一致）
DATA_DIR=/data/anitexas
# SQLite 库文件（WAL 模式；表结构见 architecture.md §4.5）
DB_PATH=/data/anitexas/anitexas.db
# 卡池产物：随发布包版本化，随 current 指针切换（管线产出 data/cards.json）
CARDS_PATH=/opt/anitexas/current/cards.json

# ---- 房间默认配置（建房时可按房覆盖，见 architecture.md §1.2 / §4.3）----
# 开局是否自动展开要素（D14 双模式合并，原 ROOM_DEFAULT_MODE 废弃）：
# false = 隐藏展示（默认；点击展开、揭示记账）；true = 开局自动展开（即原明示模式）
ROOM_DEFAULT_AUTO_REVEAL=false
# 座位数（不足自动 bot 补位；A3.5 验收场景为 1 人 + 3 bot）
ROOM_DEFAULT_SEATS=4
# 盲注与初始筹码：德州默认 1/2，100BB 入桌（规则书参数表：盲注为配置项）
ROOM_DEFAULT_SMALL_BLIND=1
ROOM_DEFAULT_BIG_BLIND=2
ROOM_DEFAULT_CHIPS=200
# 牌池策略：stratified 分层随机（档位 × 要素类配额，固定 seed，D11）；主题池后置为配置
ROOM_DEFAULT_DECK_STRATEGY=stratified
# 单桌牌池规模（规则书参数表 52–104 张；蓝图 deck.go 默认 78 张）
ROOM_DEFAULT_DECK_SIZE=78
# 作品标注数下限（评分人数 = dump score_details 求和）：仅 ≥ 此值的作品入本桌牌池；
# 0 = 不过滤（默认 2000：只收「有人认识」的作品）。过滤后不足以撑牌池时回退全库并告警。
ROOM_DEFAULT_MIN_VOTES=2000
# 揭示费率：v1 恒 0，只记账不扣分（D4），账落 reveal_log
ROOM_DEFAULT_REVEAL_FEE=0
# 下注回合倒计时秒数：超时自动动作（有注弃牌 / 无注过牌，A3.6）
TURN_TIMEOUT_SECONDS=30

# ---- 对局节奏与生命周期 ----
# 下一手自动开局延迟秒数：settled 后广播 nextHand{startAt} 并排程定时器，
# 到点 active≥2 自动开局（不再要求全员 ready；全员 ready 可提前开局）；0 = 关闭
NEXT_HAND_DELAY_SECONDS=8
# 断线回收宽限秒数：真人断线超时自动离席（局中标 pendingLeave 收手生效、
# 空闲期立即释放座位，bot 补位）；0 = 不回收断线座位
DISCONNECT_GRACE_SECONDS=300
# 空闲房回收分钟数：waiting 且无在座人类持续超时即关房（closed + 摘除大厅）；0 = 不回收
IDLE_ROOM_TTL_MINUTES=10
# 每座位重买上限（破产就地重买计入，达上限自动离席、bot 补位）；0 = 不限次
MAX_REBUYS=3
